# ============================================================
# .env.example — copy to .env and edit
# ============================================================

APP_NAME=Piper TTS Scalable API
APP_VERSION=2.0.0
DEBUG=false

HOST=0.0.0.0
PORT=8000

# React frontend origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_RESULT_TTL=600
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_HARD_TIME_LIMIT=150

# Piper
MODELS_DIR=./piper_models
AUDIO_TMP_DIR=/tmp/tts_audio
AUDIO_TTL_SECONDS=3600
MAX_TEXT_LENGTH=10000

# Device: cpu | cuda | auto
# Your AMD Radeon R9 200 → use cpu
DEVICE=cpu

# Worker RAM guard (MB per worker process)
WORKER_CONCURRENCY=1
WORKER_MAX_RAM_MB=4000

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# Logging: json (prod) | text (dev)
LOG_LEVEL=INFO
LOG_FORMAT=json
